# PAIMANA Frontend — Environment Variables
#
# Copy this file to .env.local for local development overrides.
# On Vercel, set these as Environment Variables in the project dashboard.

# VITE_API_URL
# The root URL of the deployed Render backend (no trailing slash, no /api suffix).
# In development: leave this BLANK — Vite's proxy forwards /api to localhost:8000.
# In production: set this to your Render backend URL.
# Example: https://paimana-backend.onrender.com
VITE_API_URL=
