# PAIMANA Backend — Environment Variables
#
# Copy this file to .env and fill in values for local overrides.
# On Render, set these as Environment Variables in the dashboard.

# FRONTEND_URL
# The URL of the deployed Vercel frontend.
# Used to restrict CORS to only the known frontend origin in production.
# Leave blank in local development (will allow all origins automatically).
# Example: https://paimana.vercel.app
FRONTEND_URL=

# PORT (automatically injected by Render — do NOT set this manually on Render)
# Only needed if running the backend standalone outside of Render.
# PORT=8000
